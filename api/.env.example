# DepthWizard API Environment
DATABASE_URL=postgresql+psycopg://depthwizard:depthwizard@postgres:5432/depthwizard
PROJECT_ROOT=/app
DATA_DIR=/app/data
MODEL_ROOT=/app/models
DEPTH_MODEL_PATH=/app/models/depth_anything_v2_vits.pth
LAMA_MODEL_PATH=/app/models/lama
DEVICE=cpu
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
MAX_CONCURRENT_GENERATIONS=1
WORKER_POLL_INTERVAL=2.0
MAX_UPLOAD_SIZE_MB=50
