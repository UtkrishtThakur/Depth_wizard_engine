# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────

POSTGRES_USER=depthwizard
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=depthwizard


# ─────────────────────────────────────────────
# Database connection
# ─────────────────────────────────────────────

DATABASE_URL=postgresql+psycopg://depthwizard:CHANGE_THIS_TO_A_STRONG_PASSWORD@prod-depthwizard-postgres:5432/depthwizard


# ─────────────────────────────────────────────
# DepthWizard paths
# ─────────────────────────────────────────────

PROJECT_ROOT=/app
DATA_DIR=/app/data
MODEL_ROOT=/app/models


# ─────────────────────────────────────────────
# ML / Worker
# ─────────────────────────────────────────────

DEVICE=cpu
WORKER_POLL_INTERVAL=2.0


# ─────────────────────────────────────────────
# API / Frontend
# ─────────────────────────────────────────────

DEPTHWIZARD_HOST=depthwizardapi.devlooper.co.in

# Production frontend origin
# Replace with your actual frontend domain once deployed.
CORS_ORIGINS=https://your-frontend-domain.com


# ─────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────

ENVIRONMENT=production
